# Backend CLEISON - exemplo de configuracao. NAO contem credenciais reais.
# Copie para .env e preencha. Nunca versione o .env.

APP_NAME=CLEISON
APP_ENV=local
# Gere com: php artisan key:generate
APP_KEY=
# true so na maquina de desenvolvimento (mostra stack trace). Nunca em producao.
APP_DEBUG=false
APP_URL=http://localhost:8000
# config/app.php fixa timezone UTC. O fuso de apresentacao e de
# "dia local" do negocio mora em estabelecimentos.fuso_horario
# (America/Sao_Paulo inicialmente).


APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Proxy reverso na frente da aplicacao: IPs/CIDR separados por virgula.
# Vazio = nenhum (local nao precisa).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL e obrigatorio (constraints de exclusao com btree_gist).
# Local sem Docker: scripts/postgres-local.ps1 criar  (gera as senhas).
# Outro SO: PostgreSQL 18 + bancos cleison_dev/cleison_teste (backend/README.md).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=cleison_dev
# Papel da APLICACAO: so SELECT/INSERT/UPDATE/DELETE (sem DDL, TRUNCATE ou
# desligar triggers). O script local cria "cleison_app".
DB_USERNAME=cleison_app
DB_PASSWORD=
# Papel DONO do schema, usado so por: composer migrar
# (= php artisan migrate --database=pgsql_migracao).
DB_MIGRACAO_USERNAME=cleison
DB_MIGRACAO_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE fica AUSENTE de proposito: o padrao de
# config/session.php e true em APP_ENV=production e false nos demais (local
# em http funciona sem mexer). Qualquer valor definido aqui vence o padrao.
# SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sem filas na etapa 1.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Retencao LGPD de cliente inativo (docs/LGPD-ANONIMIZACAO.md, D5).
# SEM VALOR PADRAO: decisao do responsavel + juridico. Enquanto comentadas,
# a retencao automatica fica desligada (ninguem e anonimizado).
# CLEISON_RETENCAO_CLIENTE_INATIVO_MESES=
# CLEISON_RETENCAO_RESPONSAVEL_ID=

# Freios da reserva pelo site (config/cleison.php, reservas). PADROES abaixo.
# "solicitado" nao confirmado expira (vira cancelado) depois de N horas da
# criacao ou quando o inicio chega (cleison:expirar-solicitados, a cada 5 min):
# CLEISON_SOLICITADO_EXPIRA_HORAS=12
# Reservas em aberto (solicitado/confirmado futuras) por telefone para o site
# aceitar outra (o operador nao tem esse limite):
# CLEISON_MAXIMO_RESERVAS_EM_ABERTO_POR_TELEFONE=2
# Freio de emergencia: reservas criadas pelo site por dia, somando todos os
# telefones. Acima disso a API responde 503 generico (e avisa no log):
# CLEISON_TETO_DIARIO_RESERVAS_SITE=500

# O backend esta atras de proxy reverso (Netlify /api/*)? Em PRODUCAO e
# obrigatoria, true ou false, sem padrao: a trava de boot recusa subir sem
# ela, e recusa true com TRUSTED_PROXIES vazio. Fora de producao, opcional.
# API_ATRAS_DE_PROXY=false

# API publica v1: limites de requisicao (config/cleison.php, api.limites).
# Os valores abaixo sao os PADROES; descomente so para mudar.
# Limites por IP: so com IP confiavel (sem proxy, ou TRUSTED_PROXIES certo).
# false: sem limite por IP; ficam os por telefone e por codigo e um global
# alto por rota (API_LIMITE_GLOBAL_POR_MINUTO_POR_ROTA).
# API_LIMITE_POR_IP=true
# Toda rota, por IP, por minuto:
# API_LIMITE_GERAL_POR_MINUTO=60
# POST /api/v1/reservas: por IP por minuto e por telefone por hora:
# API_LIMITE_CRIAR_POR_MINUTO_IP=10
# API_LIMITE_CRIAR_POR_HORA_TELEFONE=5
# consultar/cancelar/remarcar: por IP + codigo por minuto e por IP por hora:
# API_LIMITE_RESERVA_POR_MINUTO_IP_CODIGO=5
# API_LIMITE_RESERVA_POR_HORA_IP=30
# Com API_LIMITE_POR_IP=false: por rota, todos os clientes juntos, por minuto:
# API_LIMITE_GLOBAL_POR_MINUTO_POR_ROTA=600
