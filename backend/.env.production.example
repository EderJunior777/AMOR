# Backend CLEISON - exemplo de configuracao de PRODUCAO. NAO contem segredos.
# Os valores vazios sao preenchidos pelo gerenciador de segredos do servidor.
# A trava de boot (App\Support\TravaDeProducao) recusa subir se este arquivo
# for relaxado: APP_DEBUG ligado, APP_KEY vazia, cookie sem Secure, sslmode
# fraco, TRUSTED_PROXIES=* ou DB_MIGRACAO_PASSWORD presente, e tambem sem
# API_ATRAS_DE_PROXY (ou com true e TRUSTED_PROXIES vazio).

APP_NAME=CLEISON
APP_ENV=production
# Segredo. Gere uma vez (php artisan key:generate --show) e guarde no cofre.
APP_KEY=
APP_DEBUG=false
APP_URL=https://exemplo.invalid

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Proxy reverso / balanceador na frente da aplicacao: IPs ou CIDR separados
# por virgula. Vazio = nenhum proxy confiavel. Curinga (*) e recusado.
TRUSTED_PROXIES=
# OBRIGATORIA, sem padrao: true se a API passa por proxy reverso (Netlify
# /api/*), false se o cliente chega direto. true exige TRUSTED_PROXIES com os
# IPs de saida do proxy. Vazia, a aplicacao nao sobe (backend/README.md,
# "Proxies confiaveis").
API_ATRAS_DE_PROXY=

# Um arquivo por dia, 14 dias. Nada de debug/info em producao: as
# mensagens de nivel baixo podem carregar dados de clientes.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL >= 17. Papel da APLICACAO (so DML), nunca o dono do schema.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=cleison
DB_USERNAME=cleison_app
# Segredo.
DB_PASSWORD=
# TLS com verificacao do certificado E do nome do host.
DB_SSLMODE=verify-full
# Certificado raiz da CA do provedor do banco (caminho no servidor).
DB_SSLROOTCERT=
# SEM DB_MIGRACAO_*: a senha do papel dono (cleison) nao mora no servidor
# web. As migrations rodam no pipeline de deploy, com um segredo separado
# (backend/README.md, "Deploy").

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE fica ausente: em producao o padrao e true.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Sem envio de e-mail nesta etapa.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Retencao LGPD de cliente inativo (docs/LGPD-ANONIMIZACAO.md, D5).
# SEM VALOR PADRAO: decisao do responsavel + juridico. Enquanto comentadas,
# a retencao automatica fica desligada (ninguem e anonimizado).
# CLEISON_RETENCAO_CLIENTE_INATIVO_MESES=
# CLEISON_RETENCAO_RESPONSAVEL_ID=

# Freios da reserva pelo site (PADROES; descomente so para mudar):
# CLEISON_SOLICITADO_EXPIRA_HORAS=12
# CLEISON_MAXIMO_RESERVAS_EM_ABERTO_POR_TELEFONE=2
# CLEISON_TETO_DIARIO_RESERVAS_SITE=500
